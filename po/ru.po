#: src/extension.js:43
#, javascript-format
msgid "For %d Day"
msgid_plural "For %d Days"
msgstr[0] "На %d день"
msgstr[1] "На %d дня"
msgstr[2] "На %d дней"

#: src/extension.js:48
#, javascript-format
msgid "For %d Hour"
msgid_plural "For %d Hours"
msgstr[0] "На %d час"
msgstr[1] "На %d часа"
msgstr[2] "На %d часов"

#: src/extension.js:51
#, javascript-format
msgid "For %d Minute"
msgid_plural "For %d Minutes"
msgstr[0] "На %d минуту"
msgstr[1] "На %d минуты"
msgstr[2] "На %d минут"

#. Translators: when Do Not Disturb turns off, e.g. "Until 18:30"
#: src/extension.js:61
#, javascript-format
msgid "Until %s"
msgstr "До %s"

#. Translators: when Do Not Disturb turns off,
#. e.g. "Until 9:00 tomorrow"
#: src/extension.js:67
#, javascript-format
msgid "Until %s tomorrow"
msgstr "До %s завтра"

#. Translators: date format used in "Until %1$s, %2$s", see `man date`
#: src/extension.js:71
msgid "%B %-d"
msgstr "%-d %B"

#. Translators: when Do Not Disturb turns off, %1$s is the date and
#. %2$s is the time, e.g. "Until October 15, 18:30"
#: src/extension.js:74
msgid "Until %1$s, %2$s"
msgstr "До %1$s, %2$s"

#: src/extension.js:205
msgid "Do Not Disturb for a While"
msgstr "Не беспокоить на время"

#: src/extension.js:281
msgid "Until I Turn It Off"
msgstr "Пока не выключу"
